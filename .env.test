NODE_ENV=test
PORT=4001
LOG_LEVEL=silent
TRUST_PROXY=1
DATABASE_URL=postgresql://mac@localhost:5432/timeflow_test?schema=public
REDIS_URL=redis://localhost:6379/1
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
JWT_ACCESS_SECRET=test-secret-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
CACHE_TTL_SECONDS=60
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_API_MAX=10000
RATE_LIMIT_API_WINDOW_SECONDS=60
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM="TimeFlow <no-reply@timeflow.dev>"
EMAIL_FAILURE_RATE=0
WORKER_CONCURRENCY=1
UPLOAD_DIR=./uploads-test
RATE_LIMIT_EMAIL_MAX=500
RATE_LIMIT_EMAIL_WINDOW_SECONDS=60
# Pinned so the developer's backend/.env (loaded by dotenv for anything unset
# here) can never route test mail through a real account.
EMAIL_PROVIDER=log
EMAIL_ALLOW_REAL_SEND=false
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_USER=
SMTP_PASS=
INBOUND_SYNC_ENABLED=false
