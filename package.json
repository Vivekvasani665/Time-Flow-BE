{
  "name": "timeflow-backend",
  "version": "1.0.0",
  "private": true,
  "description": "TimeFlow API server and background worker",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.1",
    "@bull-board/express": "^9.10.1",
    "@prisma/client": "~6.19.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "~5.1.0",
    "helmet": "^8.3.0",
    "imapflow": "^2.0.5",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.9.28",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prisma": "~6.19.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "~4.1.13"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "~3.2.7"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@scarf/scarf": false,
    "msgpackr-extract": false
  }
}
